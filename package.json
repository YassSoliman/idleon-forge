{
  "name": "idleon-forge",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Open-source, read-only companion tools (Mods) for Legends of IdleOn.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @idleon-forge/toolbox-parsers build && pnpm --filter @idleon-forge/activeon dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @idleon-forge/toolbox-parsers build && vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "sync-parsers": "bash packages/toolbox-parsers/scripts/sync.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
