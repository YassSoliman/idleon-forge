# Live sign-in config for ActiveOn. Copy to .env.local (gitignored) and fill in.
# These are the game's own Firebase and Google OAuth client values, which every community tool uses.
# Where to find each one: docs/setup/live-sign-in.md. Never commit real values.
# Without them the app still builds and runs; only the raw-JSON paste works.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_SECRET=
