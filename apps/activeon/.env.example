# Live sign-in config for ActiveOn. Copy to .env.local (gitignored) and fill in.
# These are the game's own Firebase and Google OAuth client values, which every community tool uses.
# Where to find each one: docs/setup/live-sign-in.md. Never commit real values.
# Without them the app still builds and runs; only the raw-JSON paste works.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_CLIENT_SECRET=

# In-app Suggestions (M13): the Suggestions Worker and the Turnstile site key. Both are public values
# (docs/setup/deploy.md#suggestions). Without them the Suggest form opens with the GitHub-issue
# fallback only. Any build but production sends Suggestions as dry runs, so nothing is filed.
VITE_SUGGESTIONS_URL=https://activeon-suggestions.idleon.workers.dev
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFZh5dFIi0_6HO68
