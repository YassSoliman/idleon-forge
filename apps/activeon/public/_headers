# Response headers for the static site (Workers static assets). M1 TR-25, M12 TR-11.
# Keep under Cloudflare's 100-rule limit. A header change ships only after a real sign-in on its
# Preview: a CSP that breaks sign-in is a P0 (M12 TR-11).

# Build stamp and changelog: the stale-tab check must always see the live build (TR-9).
/version.json
  Cache-Control: no-store
/whats-new.json
  Cache-Control: no-cache

# Hashed build output never changes under its name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page may reach only our origin, Google's OAuth endpoints, Firebase Auth / Firestore, and the
# game's Realtime Database. The RTDB SDK connects to idlemmo.firebaseio.com and is then REDIRECTED to a
# per-user shard host (e.g. s-gke-usc1-nssi4-13.firebaseio.com, seen live 2026-10-17); shards differ
# per player and change over time, so naming them breaks sign-in for anyone on a new shard. CSP can only
# wildcard the leftmost label, so *.firebaseio.com is the narrowest rule that works. Trade-off (RT-9):
# it would admit another project's RTDB, which matters only alongside an XSS, which the rest of this
# policy (no inline script, 'self' scripts) is there to prevent. The SDK's long-polling fallback uses an
# injected script and iframe, hence the same host in script-src and frame-src.
# Suggestions (M13): the app posts to the Suggestions Worker (connect-src), and Turnstile loads its
# script and challenge iframe from challenges.cloudflare.com, only when a Suggest form opens (TR-5).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.firebaseio.com https://challenges.cloudflare.com; worker-src 'self'; connect-src 'self' https://oauth2.googleapis.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://activeon-suggestions.idleon.workers.dev; frame-src https://*.firebaseio.com https://challenges.cloudflare.com; img-src 'self' data:; font-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The parse worker runs ~6 MB of vendored upstream code on our origin, where the Firebase session is
# in reach. A worker loaded from a URL takes the policy of its own response: with no network it can't
# send anything anywhere or write to the save. The /* policy also matches here; the two values are
# joined with a comma, which a browser enforces as two policies (both must allow a request), so the
# worker's effective connect-src is still 'none'. bundle-guards.ts keeps the file name matching.
/assets/parse.worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'none'
